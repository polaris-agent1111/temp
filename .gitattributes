# 统一换行策略：仓库内文本一律 LF，checkout 后仍保持 LF。
# 官方评测对 pacer.txt 的换行敏感（CRLF 会导致运行时段解析失败），因此不做任何自动转换。
* text=auto eol=lf

# 明确的文本类型（团队约定：所有代码/配置/文档使用 LF）
*.md          text eol=lf
*.py          text eol=lf
*.sh          text eol=lf
*.json        text eol=lf
*.jsonl       text eol=lf
*.txt         text eol=lf
*.csv         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.ini         text eol=lf
*.cfg         text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf
pacer.txt     text eol=lf

# Windows 侧脚本保留 CRLF（避免 cmd.exe / PowerShell 解析问题）
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# 二进制：禁止换行转换与文本 diff
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
*.pdf         binary
*.doc         binary
*.docx        binary
*.xls         binary
*.xlsx        binary
*.ppt         binary
*.pptx        binary
*.zip         binary
*.7z          binary
*.rar         binary
*.gz          binary
*.tgz         binary
*.tar         binary
*.tar.gz      binary
*.pkl         binary
*.pyc         binary
*.bin         binary
*.so          binary
*.dll         binary
*.exe         binary
