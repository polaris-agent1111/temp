# ============================================================
# iDSN 仓库 .gitignore
# 原则：凭据 / 登录态 / 抓包 / 个人隐私 / 运行产物 一律不入库
# ============================================================

# ---------- 凭据与密钥（任何情况都不得入库） ----------
client/secrets.json
client/secrets*.json
runs/.session.pkl
*.pkl
*.pickle
runs/trit_*.json
runs/login_redirect.json
*.token
*.cookie
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# ---------- 登录态 / 浏览器抓包 / 页面截图（含明文 SSH 密码 + 手机号 + 密码 MD5） ----------
runs/browser/

# ---------- 运行产物（本地实验数据；仅保留可复现的提交配置） ----------
runs/*.jsonl
runs/*.log
runs/queue*.json
runs/leaderboard_full.json
runs/leaderboard/
runs/evals/
runs/official/
# 生成出来的 pacer 目录是中间产物；只保留用于官方提交的配置包
runs/configs/*/
runs/configs/*.tar.gz
!runs/configs/submit-*.tar.gz
!runs/configs/submit-*.tar

# ---------- 平台抓包与个人隐私（手机号 / 姓名 / 学号 / 邮箱 / 报名截图） ----------
intel/raw/auth/
intel/raw/trit/
intel/raw/registration_success.png

# ---------- 平台下载的大文件 / 依赖包 ----------
# 官方资料压缩包有意入库（队友 clone 后直接可用），其余压缩包不入库
docs/*.zip
!docs/题目1附件.zip
docs/*.tar*
env/*.tar*
env/*.zip
# 会话备份与大压缩包
dsh-session-*.zip
*.zip
!docs/题目1附件.zip

# ---------- 体积与非必要材料 ----------
report/figures/_fonttest.png

# ---------- Python / 工具链 ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---------- 临时文件 ----------
tmp_*
*.tmp
*.bak
